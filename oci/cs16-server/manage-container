#!/bin/bash

set -euo pipefail

usage() {
    printf "Usage: %s <build | deploy | start | restart | stop>\n" "${0##*/}"
}

if [[ "$#" -gt 1 ]]; then
    printf "Too many arguments\n" 1>&2
    usage
    exit 1
elif [[ "$#" -eq 0 ]]; then
    usage
    exit 0
fi

oci_cmd=""

if command -v podman &> /dev/null; then
    oci_cmd="podman"
elif command -v docker &> /dev/null; then
    oci_cmd="docker"
else
    printf "Error: Neither Podman nor Docker is installed" 1>&2
    exit 1
fi

case "$1" in
    "build")
        "${oci_cmd}" build -t cs16-server .
        ;;

    "deploy")
        "${oci_cmd}" run \
                     -d \
                     --name cs16-server \
                     --init \
                     --network host \
                     --cap-drop ALL \
                     --security-opt no-new-privileges \
                     --restart unless-stopped \
                     cs16-server
        ;;

    "start")
        "${oci_cmd}" start cs16-server
        ;;

    "restart")
        "${oci_cmd}" restart cs16-server
        ;;

    "stop")
        "${oci_cmd}" stop cs16-server
        ;;

    *)
        printf "Invalid command: %s\n" "$1" 1>&2
        usage
        exit 1
        ;;
esac
