# STEAM_0:0:YOUR_STEAMID
# Only works with -secure and +sv_lan 0.
# Access with "amxmodmenu" command. Won't be set if empty.
ARG ADMIN_STEAMID=""

# Admin access with Nickname for LAN games.
# Access with "amxmodmenu" command. Won't be set if empty.
ARG ADMIN_NICKNAME=""

# YaPB Bots: 1 - On, 0 - Off.
# Won't be downloaded if set to 0.
ARG YB_BOTS="1"

# Access YaPB bots with: setinfo _ybpw "bots_password" and "yb menu" commands.
# Won't be set if empty.
ARG YB_PASSWORD=""

# Default: 9
ARG YB_QUOTA="16"

# Default: normal
# Options: normal, fill, match
ARG YB_QUOTA_MODE="fill"

# Default: 3
# Options: 0-4
ARG YB_DIFFICULTY="0"

# Default: 2
# Options: 0-2
ARG YB_RADIO_MODE="0"

# Default: 20
ARG MP_TIMELIMIT="0"

ARG STEAMCMD_LINK="https://steamcdn-a.akamaihd.net/client/steamcmd_linux.tar.gz"
ARG METAMODP_LINK="https://github.com/Bots-United/metamod-p/releases/download/v1.21p109/metamod-p-v1.21p109-linux_ubuntu2404.tar.xz"
ARG AMXMODX_BASE_LINK="https://github.com/alliedmodders/amxmodx/releases/download/1.10.0.5487/amxmodx-1.10.0-git5487-base-linux.tar.gz"
ARG AMXMODX_CSTRIKE_LINK="https://github.com/alliedmodders/amxmodx/releases/download/1.10.0.5487/amxmodx-1.10.0-git5487-cstrike-linux.tar.gz"
ARG YAPB_LINK="https://github.com/yapb/yapb/releases/download/4.4.957/yapb-4.4.957-linux.tar.xz"

FROM debian:trixie-slim AS builder

ARG STEAMCMD_LINK
ARG METAMODP_LINK
ARG AMXMODX_BASE_LINK
ARG AMXMODX_CSTRIKE_LINK
ARG YAPB_LINK
ARG YB_BOTS

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --no-install-suggests locales lib32stdc++6 ca-certificates curl xz-utils && \
    localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/hlds/.steam

RUN curl -L "${STEAMCMD_LINK}" | tar zxf - -C . && \
    curl -L "${METAMODP_LINK}" | tar Jxf - -C . && \
    curl -L "${AMXMODX_BASE_LINK}" | tar zxf - -C . && \
    curl -L "${AMXMODX_CSTRIKE_LINK}" | tar zxf - -C . && \
    if [ "${YB_BOTS}" = "1" ]; then curl -L "${YAPB_LINK}" | tar Jxf - -C .; fi

RUN ln -sf . steam && \
    ./steamcmd.sh +force_install_dir /opt/hlds/cs16 +login anonymous +app_update 90 validate +quit && \
    mv -f addons ../cs16/cstrike && \
    ln -sf linux32 sdk32

FROM debian:trixie-slim

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends --no-install-suggests locales lib32stdc++6 ca-certificates && \
    localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

ENV LANG="en_US.UTF-8"

RUN useradd -r -M -d /opt/hlds -s /sbin/nologin -c "Counter-Strike 1.6 Dedicated Server" hlds && \
    install -v -d -m 700 -o hlds -g hlds /opt/hlds

COPY --from=builder --chown=hlds:hlds /opt/hlds /opt/hlds

USER hlds
WORKDIR /opt/hlds/cs16/cstrike

ARG ADMIN_STEAMID
ARG ADMIN_NICKNAME
ARG YB_BOTS
ARG YB_PASSWORD
ARG YB_QUOTA
ARG YB_QUOTA_MODE
ARG YB_DIFFICULTY
ARG YB_RADIO_MODE
ARG MP_TIMELIMIT

RUN echo "linux addons/amxmodx/dlls/amxmodx_mm_i386.so" > addons/metamod/plugins.ini && \
    if [ -n "${ADMIN_STEAMID}" ]; then echo "\"${ADMIN_STEAMID}\" \"\" \"abcdefghijklmnopqrstuv\" \"ce\"" >> addons/amxmodx/configs/users.ini; fi && \
    if [ -n "${ADMIN_NICKNAME}" ]; then echo "\"${ADMIN_NICKNAME}\" \"\" \"abcdefghijklmnopqrstuv\" \"e\"" >> addons/amxmodx/configs/users.ini; fi && \
    # Disable AMX Mod X message
    sed -i "s|^scrollmsg\.amxx|;scrollmsg.amxx|" addons/amxmodx/configs/plugins.ini && \
    # Disable AMX Mod X message
    sed -i "s|^imessage\.amxx|;imessage.amxx|" addons/amxmodx/configs/plugins.ini && \
    sed -i "s|mp_timelimit .*|mp_timelimit ${MP_TIMELIMIT}|" server.cfg && \
    sed -i "s|^gamedll_linux.*|gamedll_linux \"addons/metamod/dlls/metamod.so\"|" liblist.gam && \
    touch listip.cfg banned.cfg

RUN if [ "${YB_BOTS}" = "1" ]; then \
        echo "linux addons/yapb/bin/yapb.so" >> addons/metamod/plugins.ini && \
        if [ -n "${YB_PASSWORD}" ]; then sed -i "s|yb_password \".*\"|yb_password \"${YB_PASSWORD}\"|" addons/yapb/conf/yapb.cfg; fi && \
        sed -i "s|yb_quota \".*\"|yb_quota \"${YB_QUOTA}\"|" addons/yapb/conf/yapb.cfg && \
        sed -i "s|yb_quota_mode \".*\"|yb_quota_mode \"${YB_QUOTA_MODE}\"|" addons/yapb/conf/yapb.cfg && \
        sed -i "s|yb_difficulty \".*\"|yb_difficulty \"${YB_DIFFICULTY}\"|" addons/yapb/conf/yapb.cfg && \
        sed -i "s|yb_radio_mode \".*\"|yb_radio_mode \"${YB_RADIO_MODE}\"|" addons/yapb/conf/yapb.cfg && \
        # Remove graph files for Counter-Strike: Condition Zero
        find addons/yapb/data/graph -name "*_cz.graph" -delete && \
        # Temporary fix for 4.4.957
        chmod 755 addons/yapb/data/* ; \
    fi

WORKDIR /opt/hlds/cs16
ENV LD_LIBRARY_PATH=/opt/hlds/cs16
ENTRYPOINT ["/opt/hlds/cs16/hlds_linux"]
CMD ["-game", "cstrike", "-insecure", "-pingboost", "3", "-maxplayers", "32", "+sys_ticrate", "1024", "+sv_lan", "1", "+ip", "0.0.0.0", "+map", "de_dust2"]
STOPSIGNAL SIGINT
