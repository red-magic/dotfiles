#!/bin/sh

set -e

progname=${0##*/}

self=$0
cr=$(printf '\r')

usage()
{
    printf "usage: %s file|directory\n" "$progname"
}

is_binary()
{
    od -A n -t x1 -v -N 512 "$1" 2>/dev/null | tr -s ' ' '\n' | LC_ALL=C grep -q '^00$'
}

has_content()
{
    rc=0
    LC_ALL=C grep -q . "$1" 2>/dev/null || rc=$?
    if [ $rc -gt 1 ]
    then
        exit $rc
    fi
    return $rc
}

report_file()
{
    if is_binary "$1"
    then
        return 0
    fi
    if ! has_content "$1"
    then
        return 0
    fi

    rc=0
    LC_ALL=C grep -q "$cr" "$1" 2>/dev/null || rc=$?
    if [ $rc -gt 1 ]
    then
        exit $rc
    fi

    if [ $rc -eq 0 ]
    then
        printf "CRLF  %s\n" "$1"
    else
        printf "  LF  %s\n" "$1"
    fi
}

report()
{
    find -H "$target" -type f -exec "$self" __report_file__ {} +
}

if [ $# -ge 2 ]
then
    case $1 in
        __report_file__)
            shift
            for file
            do
                report_file "$file"
            done
            exit 0
            ;;
    esac
fi

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

report
