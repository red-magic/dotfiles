#!/bin/sh

set -e

progname=${0##*/}
cr=$(printf '\r')

usage()
{
    printf "usage: %s file|directory\n" "$progname"
}

is_binary()
{
    od -t c "$1" | grep -q '\\0'
}

has_content()
{
    rc=0
    grep -q . "$1" 2>/dev/null || rc=$?
    [ $rc -gt 1 ] && exit $rc
    return $rc
}

report()
{
    files=$(find -H "$target" -type f)
    [ -z "$files" ] && return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue
        ! has_content "$file" && continue

        rc=0
        grep -q "$cr" "$file" 2>/dev/null || rc=$?
        [ $rc -gt 1 ] && exit $rc

        if [ $rc -eq 0 ]
        then
            printf "CRLF  %s\n" "$file"
        else
            printf "  LF  %s\n" "$file"
        fi
    done <<__FILES__
$files
__FILES__
}

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

report
