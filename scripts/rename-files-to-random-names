#!/bin/sh

set -e

progname=${0##*/}

usage()
{
    printf "usage: %s directory\n" "$progname"
}

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

cd "$1"

for file in .* *
do
    [ "$file" = "." ] && continue
    [ "$file" = ".." ] && continue
    [ -f "$file" ] || continue

    newname=$(openssl rand -hex 16)

    case ${file#.} in
        *.*) newname="$newname.${file##*.}" ;;
    esac

    mv -vf -- "$file" "$newname"
done
