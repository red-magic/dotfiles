#!/bin/sh

set -e

progname=${0##*/}

usage()
{
    printf "usage: %s directory\n" "$progname"
}

if ! command -v openssl >/dev/null 2>&1
then
    printf "%s: openssl not found in PATH\n" "$progname" 1>&2
    exit 1
fi

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

if [ ! -d "$1" ]
then
    printf "%s: not a directory: %s\n" "$progname" "$1" 1>&2
    exit 1
fi

cd "$1"

for file in .* *
do
    [ -f "$file" ] || continue

    newname=$(openssl rand -hex 16)

    case ${file#.} in
        *.*) newname="$newname.${file##*.}" ;;
    esac

    printf "%s -> %s\n" "$file" "$newname" 1>&2
    mv -f "./$file" "./$newname"
done
