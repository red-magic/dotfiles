#!/bin/sh

set -e

progname=${0##*/}

usage()
{
    printf "usage: %s directory\n" "$progname"
}

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -d "$target" ]
then
    printf "%s: not a directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

cd "$target"

for file in .[!.]* *
do
    [ ! -f "$file" ] && continue

    newname=$(od -A n -N 16 -t x1 /dev/urandom | tr -d ' \n')

    case ${file#.} in
        *.*) newname="$newname.${file##*.}" ;;
    esac

    printf "%s -> %s\n" "$file" "$newname" 1>&2
    mv -f "./$file" "./$newname"
done
