#!/bin/sh

set -e

progname=${0##*/}

if [ $# -ne 1 ]
then
    printf "usage: %s directory\n" "$progname" 1>&2
    exit 1
fi

cd "$1"

for file in .* *
do
    [ "$file" = "." ] && continue
    [ "$file" = ".." ] && continue
    [ -f "$file" ] || continue

    newname=$(openssl rand -hex 16)

    case ${file#.} in
        *.*) newname="$newname.${file##*.}" ;;
    esac

    mv -vf -- "$file" "$newname"
done
