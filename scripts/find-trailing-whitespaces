#!/bin/sh

set -e

export LC_ALL=C

progname=${0##*/}

self=$0
strip=0
cr=$(printf '\r')
pattern="[[:blank:]]\{1,\}${cr}\{0,1\}$"

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname"
}

is_binary()
{
    od -A n -t x1 -v -N 512 "$1" 2>/dev/null | tr -s ' ' '\n' | grep -q '^00$'
}

report_file()
{
    if is_binary "$1"
    then
        return 0
    fi

    rc=0
    lines=$(grep -n -e "$pattern" "$1" 2>/dev/null) || rc=$?
    if [ $rc -gt 1 ]
    then
        exit $rc
    fi
    if [ $rc -eq 1 ]
    then
        return 0
    fi

    while IFS=: read -r line text
    do
        text=${text%"$cr"}
        printf "%s:%s: %s\n" "$1" "$line" "$text"
    done <<__LINES__
$lines
__LINES__
}

strip_file()
{
    tmp=$1.tmp.$$
    cp -p "$1" "$tmp"
    sed -e 's/[[:blank:]]\{1,\}$//' -e "s/[[:blank:]]\{1,\}\(${cr}\)$/\1/" "$1" > "$tmp"
    mv "$tmp" "$1"
}

strip_file_if_needed()
{
    if is_binary "$1"
    then
        return 0
    fi

    rc=0
    grep -q -e "$pattern" "$1" 2>/dev/null || rc=$?
    if [ $rc -gt 1 ]
    then
        exit $rc
    fi
    if [ $rc -ne 0 ]
    then
        return 0
    fi

    printf "%s\n" "$1" 1>&2
    strip_file "$1"
}

report()
{
    find -H "$target" -type f -exec "$self" __report_file__ {} +
}

strip_files()
{
    find -H "$target" -type f -exec "$self" __strip_file__ {} +
}

if [ $# -ge 2 ]
then
    case $1 in
        __report_file__)
            shift
            for file
            do
                report_file "$file"
            done
            exit 0
            ;;
        __strip_file__)
            shift
            for file
            do
                strip_file_if_needed "$file"
            done
            exit 0
            ;;
    esac
fi

while getopts :s opt
do
    case $opt in
        s)
            strip=1
            ;;
        *)
            printf "%s: invalid option: -%s\n" "$progname" "$OPTARG" 1>&2
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ $strip -eq 0 ]
then
    report
else
    strip_files
fi
