#!/bin/sh

set -e

progname=${0##*/}
strip=0

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname"
}

is_binary()
{
    od -t c "$1" | grep -q '\\0'
}

report_file()
{
    rc=0
    lines=$(LC_ALL=C grep -n -e '[[:space:]]\{1,\}$' -- "$1") || rc=$?
    [ $rc -gt 1 ] && exit $rc
    [ $rc -eq 1 ] && return 0

    while IFS=: read -r line text
    do
        printf "%s:%s: %s\n" "$1" "$line" "$text"
    done <<__LINES__
$lines
__LINES__
}

strip_file()
{
    tmp="$1.tmp.$$"
    cp -p "$1" "$tmp"
    sed 's/[[:space:]]\{1,\}$//' "$1" > "$tmp"
    mv "$tmp" "$1"
}

strip_file_if_needed()
{
    rc=0
    LC_ALL=C grep -q -e '[[:space:]]\{1,\}$' -- "$1" || rc=$?
    [ $rc -gt 1 ] && exit $rc
    [ $rc -ne 0 ] && return 0

    printf "%s\n" "$1" 1>&2
    strip_file "$1"
}

report()
{
    files=$(find -H "$target" -type f)
    [ -z "$files" ] && return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue
        report_file "$file"
    done <<__FILES__
$files
__FILES__
}

strip_files()
{
    files=$(find -H "$target" -type f)
    [ -z "$files" ] && return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue
        strip_file_if_needed "$file"
    done <<__FILES__
$files
__FILES__
}

while getopts :s opt
do
    case $opt in
        s)
            strip=1
            ;;
        *)
            printf "%s: invalid option: -%s\n" "$progname" "$OPTARG" 1>&2
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ $strip -eq 0 ]
then
    report
else
    strip_files
fi
