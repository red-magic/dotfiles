#!/bin/sh

set -e

progname=${0##*/}
strip=0

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname" 1>&2
    exit 1
}

while getopts s opt
do
    case $opt in
        s) strip=1 ;;
        *) usage ;;
    esac
done

shift $((OPTIND - 1))
[ "$#" -eq 1 ] || usage
target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ "$strip" -eq 0 ]
then
    grep -Irn '[[:space:]]\{1,\}$' "$target" | while IFS=: read -r file line text
    do
        printf "%s:%s: %s\n" "$file" "$line" "$text"
    done
    exit 0
fi

grep -Irl '[[:space:]]\{1,\}$' "$target" | while IFS= read -r file
do
    printf "%s\n" "$file" >&2
    ed -s "$file" <<'ED_EOF'
g/[[:space:]]\{1,\}$/s/[[:space:]]\{1,\}$//
w
q
ED_EOF
done
