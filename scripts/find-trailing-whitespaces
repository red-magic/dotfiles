#!/bin/sh

set -e

progname=${0##*/}
strip=0

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname" 1>&2
    exit 1
}

report()
{
    rc=0
    files=$(grep -IHrn '[[:space:]]\{1,\}$' "$target") || rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    [ -n "$files" ] || return 0

    while IFS=: read -r file line text
    do
        printf "%s:%s: %s\n" "$file" "$line" "$text"
    done <<__LINES__
$files
__LINES__
}

strip_files()
{
    rc=0
    files=$(grep -Irl '[[:space:]]\{1,\}$' "$target") || rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    [ -n "$files" ] || return 0

    while IFS= read -r file
    do
        printf "%s\n" "$file" 1>&2
        ed -s "$file" <<'ED_EOF'
g/[[:space:]]\{1,\}$/s/[[:space:]]\{1,\}$//
w
q
ED_EOF
    done <<__FILES__
$files
__FILES__
}

while getopts :s opt
do
    case $opt in
        s) strip=1 ;;
        *) usage ;;
    esac
done

shift $((OPTIND - 1))
[ "$#" -eq 1 ] || usage
target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ "$strip" -eq 0 ]
then
    report
else
    strip_files
fi
