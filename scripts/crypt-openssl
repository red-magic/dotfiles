#!/bin/sh

set -e

progname=${0##*/}

cipher_algo=aes-256-cbc
digest_algo=sha512
iter_count=210000

umask 077

usage()
{
    printf "usage: %s -e file\n" "$progname"
    printf "       %s -d file.enc\n" "$progname"
}

create_tmp()
{
    n=0
    while [ $n -lt 100 ]
    do
        tmp_file=$1.$$.$n
        if ( set -C; : > "$tmp_file" ) 2>/dev/null
        then
            return 0
        fi
        n=$((n + 1))
    done
    return 1
}

encrypt()
{
    if ! create_tmp "$file_enc"
    then
        printf "%s: %s: cannot create temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap 'rm -f "$tmp_file" || :' 0
    trap 'exit 1' HUP INT TERM

    if ! openssl enc -e -$cipher_algo -md $digest_algo -pbkdf2 -iter $iter_count -salt \
         -in "$file_dec" -out "$tmp_file"
    then
        printf "%s: encryption failed\n" "$progname" 1>&2
        exit 1
    fi

    if ! mv "$tmp_file" "$file_enc"
    then
        printf "%s: %s: cannot rename temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap - 0 HUP INT TERM
}

decrypt()
{
    if ! create_tmp "$file_dec"
    then
        printf "%s: %s: cannot create temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap 'rm -f "$tmp_file" || :' 0
    trap 'exit 1' HUP INT TERM

    if ! openssl enc -d -$cipher_algo -md $digest_algo -pbkdf2 -iter $iter_count \
         -in "$file_enc" -out "$tmp_file"
    then
        printf "%s: decryption failed: invalid password or corrupted payload\n" "$progname" 1>&2
        exit 1
    fi

    if ! mv "$tmp_file" "$file_dec"
    then
        printf "%s: %s: cannot rename temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap - 0 HUP INT TERM
}

if ! command -v openssl >/dev/null 2>&1
then
    printf "%s: openssl not found in PATH\n" "$progname" 1>&2
    exit 1
fi

if [ $# -gt 2 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

case $1 in
    -e)
        mode=enc
        ;;
    -d)
        mode=dec
        ;;
    *)
        printf "%s: invalid option: %s\n" "$progname" "$1" 1>&2
        usage
        exit 1
        ;;
esac

mode_flag=$1
file=$2

if [ -z "$file" ]
then
    printf "%s: %s: missing file argument\n" "$progname" "$mode_flag" 1>&2
    usage
    exit 1
fi

case $file in
    -*) file=./$file ;;
esac

case $mode in
    enc)
        file_dec=$file
        file_enc=$file.enc

        if [ ! -f "$file_dec" ]
        then
            printf "%s: %s: file %s doesn't exist\n" "$progname" "$mode_flag" "$file_dec" 1>&2
            exit 1
        fi

        if [ -e "$file_enc" ]
        then
            printf "%s: %s: file %s already exists\n" "$progname" "$mode_flag" "$file_enc" 1>&2
            exit 1
        fi

        encrypt
        ;;
    dec)
        case $file in
            *.enc) ;;
            *)
                printf "%s: %s: not a .enc file: %s\n" "$progname" "$mode_flag" "$file" 1>&2
                exit 1
                ;;
        esac

        file_enc=$file
        file_dec=${file%.enc}

        if [ -z "$file_dec" ]
        then
            printf "%s: %s: invalid file name: %s\n" "$progname" "$mode_flag" "$file" 1>&2
            exit 1
        fi

        if [ ! -f "$file_enc" ]
        then
            printf "%s: %s: file %s doesn't exist\n" "$progname" "$mode_flag" "$file_enc" 1>&2
            exit 1
        fi

        if [ -e "$file_dec" ]
        then
            printf "%s: %s: file %s already exists\n" "$progname" "$mode_flag" "$file_dec" 1>&2
            exit 1
        fi

        decrypt
        ;;
esac
