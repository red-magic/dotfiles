#!/bin/sh

set -e

progname=${0##*/}

export LC_ALL=C

rand_hex=$(od -A n -N 5 -t x1 /dev/urandom | tr -d ' \n')

case $rand_hex in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *)
        printf "%s: failed to generate random bytes\n" "$progname" 1>&2
        exit 1
        ;;
esac

ula_prefix=$(printf "fd%s\n" "$rand_hex" | sed 's/\(....\)\(....\)\(....\)/\1:\2:\3/')

printf "prefix:       %s::/48\n" "$ula_prefix"
printf "first subnet: %s:0::/64\n" "$ula_prefix"
printf "last subnet:  %s:ffff::/64\n\n" "$ula_prefix"

printf "router:       %s:0::1\n" "$ula_prefix"
printf "first host:   %s:0::100\n" "$ula_prefix"
printf "last host:    %s:0:ffff:ffff:ffff:ffff\n" "$ula_prefix"
