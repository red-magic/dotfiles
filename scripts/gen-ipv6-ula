#!/bin/sh

set -e

rand_hex=$(dd if=/dev/urandom bs=5 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
ula_prefix=$(printf "fd%s" "$rand_hex" | sed 's/\(....\)\(....\)\(....\)/\1:\2:\3/')

printf "prefix:       %s::/48\n" "$ula_prefix"
printf "first subnet: %s:0::/64\n" "$ula_prefix"
printf "last subnet:  %s:ffff::/64\n\n" "$ula_prefix"

printf "router:       %s:0::1\n" "$ula_prefix"
printf "first host:   %s:0::100\n" "$ula_prefix"
printf "last host:    %s:0::ffff\n" "$ula_prefix"
