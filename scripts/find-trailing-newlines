#!/bin/sh

set -e

progname=${0##*/}
strip=0

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname"
}

is_binary()
{
    od -t c "$1" | grep -q '\\0'
}

has_trailing_newlines()
{
    [ "$(tail -c 2 "$1" | wc -l)" -eq 2 ]
}

report()
{
    files=$(find -H "$target" -type f)
    [ -n "$files" ] || return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue
        has_trailing_newlines "$file" || continue
        printf "%s\n" "$file"
    done <<__FILES__
$files
__FILES__
}

strip_file()
{
    tmp="$1.tmp.$$"
    cp -p "$1" "$tmp"
    content=$(cat "$1")
    printf '%s\n' "$content" > "$tmp"
    mv "$tmp" "$1"
}

strip_files()
{
    files=$(find -H "$target" -type f)
    [ -n "$files" ] || return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue
        has_trailing_newlines "$file" || continue
        printf "%s\n" "$file" 1>&2
        strip_file "$file"
    done <<__FILES__
$files
__FILES__
}

while getopts :s opt
do
    case $opt in
        s)
            strip=1
            ;;
        *)
            printf "%s: invalid option: -%s\n" "$progname" "$OPTARG" 1>&2
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ "$strip" -eq 0 ]
then
    report
else
    strip_files
fi
