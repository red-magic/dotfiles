#!/bin/sh

set -e

progname=${0##*/}

self=$0
strip=0

usage()
{
    printf "usage: %s [-s] file|directory\n" "$progname"
}

is_binary()
{
    od -t c "$1" 2>/dev/null | LC_ALL=C grep -q '\\0'
}

has_trailing_newlines()
{
    [ "$(tail -c 2 "$1" 2>/dev/null | wc -l)" -eq 2 ]
}

report_file()
{
    if is_binary "$1"
    then
        return 0
    fi
    if has_trailing_newlines "$1"
    then
        printf "%s\n" "$1"
    fi
}

strip_file()
{
    tmp=$1.tmp.$$
    content=$(cat "$1")
    cp -p "$1" "$tmp"
    printf '%s\n' "$content" > "$tmp"
    mv "$tmp" "$1"
}

strip_file_if_needed()
{
    if is_binary "$1"
    then
        return 0
    fi
    if has_trailing_newlines "$1"
    then
        printf "%s\n" "$1" 1>&2
        strip_file "$1"
    fi
}

report()
{
    find -H "$target" -type f -exec "$self" __report_file__ {} +
}

strip_files()
{
    find -H "$target" -type f -exec "$self" __strip_file__ {} +
}

if [ $# -ge 2 ]
then
    case $1 in
        __report_file__)
            shift
            for file
            do
                report_file "$file"
            done
            exit 0
            ;;
        __strip_file__)
            shift
            for file
            do
                strip_file_if_needed "$file"
            done
            exit 0
            ;;
    esac
fi

while getopts :s opt
do
    case $opt in
        s)
            strip=1
            ;;
        *)
            printf "%s: invalid option: -%s\n" "$progname" "$OPTARG" 1>&2
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

if [ $strip -eq 0 ]
then
    report
else
    strip_files
fi
