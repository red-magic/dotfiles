#!/bin/sh

set -e

progname=${0##*/}

cipher_algo=AES256
digest_algo=SHA512

umask 077

usage()
{
    printf "usage: %s -s file\n" "$progname"
    printf "       %s -a file\n" "$progname"
    printf "       %s -d file.gpg\n" "$progname"
}

create_tmp()
{
    n=0
    while [ $n -lt 100 ]
    do
        tmp_file=$1.$$.$n
        if ( set -C; : > "$tmp_file" ) 2>/dev/null
        then
            return 0
        fi
        n=$((n + 1))
    done
    return 1
}

encrypt_sym()
{
    if ! create_tmp "$file_enc"
    then
        printf "%s: %s: cannot create temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap 'rm -f "$tmp_file" || :' 0
    trap 'exit 1' HUP INT TERM

    if ! gpg -o "$tmp_file" \
         --s2k-cipher-algo "$cipher_algo" \
         --s2k-digest-algo "$digest_algo" \
         --force-aead \
         --no-compress \
         -c -- "$file_dec"
    then
        printf "%s: %s: symmetric encryption failed\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    if ! mv "$tmp_file" "$file_enc"
    then
        printf "%s: %s: cannot rename temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap - 0 HUP INT TERM
}

encrypt_asym()
{
    if ! create_tmp "$file_enc"
    then
        printf "%s: %s: cannot create temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap 'rm -f "$tmp_file" || :' 0
    trap 'exit 1' HUP INT TERM

    if ! gpg -o "$tmp_file" \
         --cipher-algo "$cipher_algo" \
         --digest-algo "$digest_algo" \
         --force-aead \
         --no-compress \
         -e -s -- "$file_dec"
    then
        printf "%s: %s: asymmetric encryption failed\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    if ! mv "$tmp_file" "$file_enc"
    then
        printf "%s: %s: cannot rename temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap - 0 HUP INT TERM
}

decrypt()
{
    if ! create_tmp "$file_dec"
    then
        printf "%s: %s: cannot create temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap 'rm -f "$tmp_file" || :' 0
    trap 'exit 1' HUP INT TERM

    if ! gpg -d -o "$tmp_file" -- "$file_enc"
    then
        printf "%s: %s: decryption failed\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    if ! mv "$tmp_file" "$file_dec"
    then
        printf "%s: %s: cannot rename temporary file\n" "$progname" "$mode_flag" 1>&2
        exit 1
    fi

    trap - 0 HUP INT TERM
}

if ! command -v gpg >/dev/null 2>&1
then
    printf "%s: gpg not found in PATH\n" "$progname" 1>&2
    exit 1
fi

if [ $# -gt 2 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

mode=

case $1 in
    -s)
        mode=sym
        ;;
    -a)
        mode=asym
        ;;
    -d)
        mode=dec
        ;;
    *)
        printf "%s: invalid option: %s\n" "$progname" "$1" 1>&2
        usage
        exit 1
        ;;
esac

mode_flag=$1
file=$2

if [ -z "$file" ]
then
    printf "%s: %s: missing file argument\n" "$progname" "$mode_flag" 1>&2
    usage
    exit 1
fi

case $file in
    -*) file=./$file ;;
esac

case $mode in
    sym | asym)
        file_dec=$file
        file_enc=$file.gpg

        if [ ! -f "$file_dec" ]
        then
            printf "%s: %s: file %s doesn't exist\n" "$progname" "$mode_flag" "$file_dec" 1>&2
            exit 1
        fi

        if [ -e "$file_enc" ]
        then
            printf "%s: %s: file %s already exists\n" "$progname" "$mode_flag" "$file_enc" 1>&2
            exit 1
        fi
        ;;
    dec)
        case $file in
            *.gpg) ;;
            *)
                printf "%s: %s: not a .gpg file: %s\n" "$progname" "$mode_flag" "$file" 1>&2
                exit 1
                ;;
        esac

        file_enc=$file
        file_dec=${file%.gpg}

        if [ -z "$file_dec" ]
        then
            printf "%s: %s: invalid file name: %s\n" "$progname" "$mode_flag" "$file" 1>&2
            exit 1
        fi

        if [ ! -f "$file_enc" ]
        then
            printf "%s: %s: file %s doesn't exist\n" "$progname" "$mode_flag" "$file_enc" 1>&2
            exit 1
        fi

        if [ -e "$file_dec" ]
        then
            printf "%s: %s: file %s already exists\n" "$progname" "$mode_flag" "$file_dec" 1>&2
            exit 1
        fi
        ;;
esac

case $mode in
    sym)
        encrypt_sym
        ;;
    asym)
        encrypt_asym
        ;;
    dec)
        decrypt
        ;;
esac
