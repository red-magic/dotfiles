#!/bin/sh

set -e

progname=${0##*/}
cr=$(printf '\r')

usage()
{
    printf "usage: %s file|directory\n" "$progname"
}

is_binary()
{
    od -t c "$1" | grep -q '\\0'
}

report()
{
    files=$(find -H "$target" -type f)
    [ -z "$files" ] && return 0

    while IFS= read -r file
    do
        is_binary "$file" && continue

        rc=0
        last=$(tail -c 1 "$file" 2>/dev/null) || rc=$?
        [ $rc -ne 0 ] && continue

        case $last in
            "" | "$cr") ;;
            *) printf "%s\n" "$file" ;;
        esac
    done <<__FILES__
$files
__FILES__
}

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

report
