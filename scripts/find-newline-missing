#!/bin/sh

set -e

progname=${0##*/}

usage()
{
    printf "usage: %s file|directory\n" "$progname"
}

report()
{
    files=$(find -H "$target" -type f)
    [ -n "$files" ] || return 0

    while IFS= read -r file
    do
        last=$(tail -c 1 "$file" 2>/dev/null) || continue
        case $last in
            "" | "$(printf "\n")" | "$(printf "\r")") ;;
            *) printf "%s\n" "$file" ;;
        esac
    done <<__FILES__
$files
__FILES__
}

if [ $# -gt 1 ]
then
    printf "%s: too many arguments\n" "$progname" 1>&2
    usage
    exit 1
elif [ $# -eq 0 ]
then
    usage
    exit 0
fi

target=$1

if [ ! -e "$target" ]
then
    printf "%s: no such file or directory: %s\n" "$progname" "$target" 1>&2
    exit 1
fi

report
